{
    "name": "@bin-ecommerce/crawl-tiki",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "type-check": "tsc -p tsconfig.json --noEmit",
        "test": "npm run type-check",
        "crawl:brands": "npm run build && node dist/crawl-brands.js",
        "crawl:brands:official": "npm run crawl:brands -- --output data/tiki-brands.json --report data/tiki-brands.report.json",
        "import:brands": "npm run crawl:brands -- --input data/tiki-brands.json --import",
        "import:brands:official": "npm run crawl:brands -- --import"
    },
    "dependencies": {
        "pg": "^8.13.3"
    },
    "devDependencies": {
        "@types/pg": "^8.11.10"
    }
}
