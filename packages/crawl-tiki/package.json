{
  "name": "@bin-ecommerce/crawl-tiki",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "crawl": "npm run build && node dist/index.js",
    "crawl:sample": "npm run crawl -- --keyword laptop --pages 1 --limit 10 --details",
    "import:sample": "npm run crawl -- --keyword laptop --pages 1 --limit 5 --details --import",
    "import:product-service": "npm run build && node dist/import-product-service.js"
  },
  "dependencies": {
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
