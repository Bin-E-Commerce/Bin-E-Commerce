{
  "name": "bin-ecommerce",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "infra:up": "docker compose --env-file infra/docker/.env --env-file .env -f infra/docker/docker-compose.infra.yml up -d",
    "infra:down": "docker compose --env-file infra/docker/.env --env-file .env -f infra/docker/docker-compose.infra.yml down",
    "infra:logs": "docker compose --env-file infra/docker/.env --env-file .env -f infra/docker/docker-compose.infra.yml logs -f",
    "services:up": "docker compose --env-file .env up -d",
    "services:up:prod": "docker compose --env-file .env.production up -d",
    "services:down": "docker compose down",
    "services:build": "docker compose build"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "form-data": "4.0.6",
    "multer": "2.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
