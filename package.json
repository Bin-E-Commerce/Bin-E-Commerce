{
    "name": "bin-ecommerce",
    "version": "1.0.0",
    "private": true,
    "packageManager": "npm@10.9.3",
    "workspaces": [
        "packages/*",
        "services/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "type-check": "turbo run type-check",
        "recommendation:session-context-evaluate": "npm run ranking-session-context-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "recommendation:criterion-3-semantic-evaluate": "npm run ranking-criterion-3-semantic-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "recommendation:criterion-4-cobehavior-evaluate": "npm run ranking-criterion-4-cobehavior-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "recommendation:criterion-5-popularity-evaluate": "npm run ranking-criterion-5-popularity-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "recommendation:criterion-6-freshness-evaluate": "npm run ranking-criterion-6-freshness-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "recommendation:criterion-7-quality-evaluate": "npm run ranking-criterion-7-quality-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "recommendation:criterion-8-exploration-evaluate": "npm run ranking-criterion-8-exploration-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "recommendation:criteria-3-8-evaluate": "npm run ranking-criteria-3-8-evaluate --workspace=@bin-ecommerce/recommendation-service",
        "infra:up": "docker compose --env-file infra/docker/.env --env-file .env -f infra/docker/docker-compose.infra.yml up -d",
        "infra:down": "docker compose --env-file infra/docker/.env --env-file .env -f infra/docker/docker-compose.infra.yml down",
        "infra:logs": "docker compose --env-file infra/docker/.env --env-file .env -f infra/docker/docker-compose.infra.yml logs -f",
        "services:up": "docker compose --env-file .env up -d",
        "services:up:prod": "docker compose --env-file .env.production up -d",
        "services:down": "docker compose down",
        "services:build": "docker compose build"
    },
    "devDependencies": {
        "@nestjs/common": "11.2.7",
        "@nestjs/core": "11.2.7",
        "@nestjs/microservices": "11.2.7",
        "@nestjs/platform-express": "11.2.7",
        "@nestjs/testing": "11.2.7",
        "@types/node": "^22.10.7",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "eslint": "^10.2.1",
        "turbo": "^2.3.3",
        "typescript": "^5.7.3"
    },
    "overrides": {
        "brace-expansion@^1.1.0": "1.1.21",
        "brace-expansion@^2.0.0": "2.1.7",
        "brace-expansion@^5.0.0": "5.0.12",
        "form-data": "4.0.6",
        "multer": "2.5.0",
        "proxy-addr": "2.0.8",
        "body-parser": "2.4.0",
        "follow-redirects": "1.16.2"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    }
}
