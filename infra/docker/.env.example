# ============================================================================
# Environment cho runtime local cua Bin E-Commerce
# ============================================================================
# PostgreSQL, MongoDB, Redis va Qdrant da chuyen sang managed cloud.
# Endpoint va credential database duoc dat trong root .env.
#
# Chay infra:
# docker compose --env-file infra/docker/.env --env-file .env -f infra/docker/docker-compose.infra.yml up -d
# ============================================================================

# ----------------------------------------------------------------------------
# 01. Keycloak
# ----------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# PostgreSQL local riêng cho Keycloak; không dùng database production.
# Có thể đổi password này trong file infra/docker/.env local.
KEYCLOAK_LOCAL_DB_NAME=bin_ecommerce_auth_local
KEYCLOAK_LOCAL_DB_USER=keycloak_local
KEYCLOAK_LOCAL_DB_PASSWORD=local-keycloak-db-password
