# ============================================================================
# Mẫu biến môi trường cho Infra Compose của Bin E-Commerce
# ============================================================================
# File này chỉ chứa tên biến và để trống secret; sao chép thành infra/docker/.env rồi điền giá trị.
# Chỉ dùng cho infra/docker/docker-compose.infra.yml; application services
# nhận cấu hình kết nối riêng từ docker-compose.yml ở thư mục root.
# Production nên inject secret bằng AWS Secrets Manager, SSM hoặc Kubernetes Secret.
# ============================================================================

# ----------------------------------------------------------------------------
# 01. PostgreSQL - database quan hệ dùng chung
# ----------------------------------------------------------------------------
# PostgreSQL phục vụ postgres, db-init và database của Keycloak.
POSTGRES_USER= # User quản trị PostgreSQL local
POSTGRES_PASSWORD= # Mật khẩu PostgreSQL local
POSTGRES_DB= # Database khởi tạo mặc định

# ----------------------------------------------------------------------------
# 02. MongoDB - database document
# ----------------------------------------------------------------------------
# MongoDB lưu dữ liệu document cho các service cần persistence dạng document.
MONGO_ROOT_USER= # Tài khoản root MongoDB local
MONGO_ROOT_PASSWORD= # Mật khẩu root MongoDB local

# ----------------------------------------------------------------------------
# 03. Redis - cache, session và realtime state
# ----------------------------------------------------------------------------
# Redis bật requirepass; password phải giống cấu hình của mọi application client.
REDIS_PASSWORD= # Mật khẩu Redis dùng chung

# ----------------------------------------------------------------------------
# 04. Keycloak - identity và access management
# ----------------------------------------------------------------------------
# Tài khoản admin dùng để truy cập Keycloak local tại host port 8080.
KEYCLOAK_ADMIN_USER= # Tài khoản admin Keycloak local
KEYCLOAK_ADMIN_PASSWORD= # Mật khẩu admin Keycloak local

# ----------------------------------------------------------------------------
# 05. Grafana - dashboard quan sát hệ thống
# ----------------------------------------------------------------------------
# Tài khoản admin dùng để truy cập Grafana local tại host port 3030.
GRAFANA_ADMIN_PASSWORD= # Mật khẩu admin Grafana local
