# ============================================================
# Bin E-Commerce - Local Infra Docker Compose Environment
# ============================================================
# Scope:
# - This root env file is only for infra/docker/docker-compose.infra.yml.
# - Application services run locally with their own service-level .env files.
# - Keep only variables referenced by docker-compose.infra.yml here.
# - Do not use this file as a production secret source.
#
# Production:
# - Inject environment variables per service by AWS Secrets Manager,
#   AWS SSM Parameter Store, Kubernetes Secret, ECS Task Definition,
#   GitHub Actions Secrets, or your deployment platform.
# ============================================================

# PostgreSQL - postgres, db-init and Keycloak database connection
POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=bin_ecommerce

# MongoDB - mongodb root user
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme_mongo

# Keycloak - local admin console account
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_admin

# Grafana - local admin password
GRAFANA_ADMIN_PASSWORD=changeme_grafana
