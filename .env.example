# ============================================================================
# Mẫu biến môi trường cho Docker Compose ở thư mục root
# ============================================================================
# Sao chép file này thành .env rồi điền các secret trước khi chạy:
#   Copy-Item .env.example .env
#
# File này chỉ chứa giá trị mặc định an toàn hoặc để trống; không đặt API key,
# password, token thật vào đây. Database dùng managed cloud cho dev/demo và production.
# Docker Compose chỉ đọc .env để nội suy; service nhận biến qua environment tương ứng.
# ============================================================================

# ----------------------------------------------------------------------------
# 00. Runtime chung
# ----------------------------------------------------------------------------
NODE_ENV=development                                     # development/test/production; production bật giới hạn AI 3 batch/giờ

# ----------------------------------------------------------------------------
# 01. Database cloud
# ----------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSL=true
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=
MONGODB_URI=
KEYCLOAK_POSTGRES_DB=bin_ecommerce_auth

# ----------------------------------------------------------------------------
# 02. Redis cache và session
# ----------------------------------------------------------------------------
# Dùng rediss:// với Redis cloud; tất cả service dùng chung password và logical DB.
REDIS_URL=
REDIS_PASSWORD=                                    # Mật khẩu Redis, tạo secret riêng khi deploy
REDIS_DB=0
REDIS_DB_RECOMMENDATION=0

# ----------------------------------------------------------------------------
# 03. Qdrant vector database
# ----------------------------------------------------------------------------
# Lưu vector embedding và phục vụ semantic search; endpoint nằm ngoài Docker.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT_MS=3000
QDRANT_INIT_RETRY_MS=5000
QDRANT_COLLECTION_VERSION=1
QDRANT_ALIAS_PROMOTION_ENABLED=false

# ----------------------------------------------------------------------------
# 04. Keycloak và service authentication
# ----------------------------------------------------------------------------
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=auth-service-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_WEB_CLIENT_SECRET=
# Không commit secret Google; chỉ dùng script cấu hình Keycloak local nếu muốn test Google OAuth.
KEYCLOAK_GOOGLE_CLIENT_SECRET=
KEYCLOAK_PUBLIC_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=

# ----------------------------------------------------------------------------
# 05. AI service và embedding
# ----------------------------------------------------------------------------
# AI_DATABASE_URL dùng postgresql+asyncpg:// cho SQLAlchemy async trong AI Service.
AI_RUNTIME_MODE=service
AI_DATABASE_URL=
AI_REDIS_URL=                                      # URL TLS, dạng rediss://default:PASSWORD@HOST:6379
AI_IMAGE_BACKGROUND_ENCRYPTION_KEY=                # Fernet key; bắt buộc khi bật image optimization
AI_IMAGE_PREVIEW_QUALITY=low
AI_IMAGE_PREVIEW_SIZE=1024x1024
AI_IMAGE_PREVIEW_COMPRESSION=65
AI_IMAGE_PREVIEW_MAX_DIMENSION=768
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_JOB_MAX_ATTEMPTS=8
EMBEDDING_RESULT_CACHE_TTL_SECONDS=600

# ----------------------------------------------------------------------------
# 06. LightGBM ranking
# ----------------------------------------------------------------------------
# Đường dẫn model trong container; model được mount từ ./services/ai-service/artifacts.
ML_RANKING_ENABLED=true
ML_RANKING_BLEND=0.3
ML_RANKING_POLICY_VERSION=ml-hybrid-v1
ML_RANKING_TIMEOUT_MS=150
RANKING_MODEL_PATH=/app/artifacts/ranking.txt
RANKING_MODEL_VERSION=ranking-lgbm-demo-v1
RANKING_EXPECTED_FEATURES=9

# ----------------------------------------------------------------------------
# 07. Recommendation và candidate pipeline
# ----------------------------------------------------------------------------
# Các feature flag và retention policy của Recommendation Service.
CANDIDATE_PIPELINE_V3_ENABLED=true
SEMANTIC_CANDIDATES_ENABLED=true
CO_BEHAVIOR_CANDIDATES_ENABLED=true
RECOMMENDATION_CACHE_TTL_SECONDS=300
RECOMMENDATION_SESSION_TTL_SECONDS=86400
RECOMMENDATION_SESSION_MAX_RECENT_ITEMS=30
RECOMMENDATION_RETENTION_ENABLED=false
RECOMMENDATION_RAW_RETENTION_DAYS=90
RECOMMENDATION_AGGREGATE_RETENTION_DAYS=365
RECOMMENDATION_RELATION_SAFETY_DAYS=7
RECOMMENDATION_EMBEDDING_JOB_RETENTION_DAYS=90
RECOMMENDATION_REPLAY_JOB_RETENTION_DAYS=30
RECOMMENDATION_RELATION_CO_VIEW_WEIGHT=1
RECOMMENDATION_RELATION_CO_CLICK_WEIGHT=2
RECOMMENDATION_RELATION_CO_IMPRESSION_WEIGHT=0.05
RECOMMENDATION_RELATION_CO_CART_WEIGHT=3
RECOMMENDATION_RELATION_CO_PURCHASE_WEIGHT=6
RELATION_SCORE_HALF_LIFE_DAYS=30

# ----------------------------------------------------------------------------
# 08. Media, S3 và CDN
# ----------------------------------------------------------------------------
# Production nên dùng IAM Role/Workload Identity thay vì ghi access key vào env.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=bin-ecommerce
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_CDN_URL=https://dlmj9cgl5muim.cloudfront.net
MEDIA_REQUEST_BODY_LIMIT=12mb
MEDIA_UPLOAD_EXPIRES_SECONDS=300
MEDIA_MAX_UPLOAD_SIZE_BYTES=5242880

# ----------------------------------------------------------------------------
# 09. Email và vận chuyển
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@binecommerce.local
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_CLIENT_ID=
GHN_SERVICE_TYPE_ID=2
GHN_REQUEST_TIMEOUT_MS=10000
SHIPPING_DEMO_MODE=true
MAP_DEFAULT_LATITUDE=10.7769
MAP_DEFAULT_LONGITUDE=106.7009

# ----------------------------------------------------------------------------
# 10. URL frontend, CORS và runtime
# ----------------------------------------------------------------------------
# Phân tách cấu hình web public, CORS, port, Kafka retry và SQL logging.
WEB_BASE_URL=http://localhost:5173

# URL frontend local và callback OAuth.
FRONTEND_URL=http://localhost:5173
SOCIAL_AUTH_CALLBACK_URL=http://localhost:5173/callback

# ----------------------------------------------------------------------------
# 11. CORS cho frontend local
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------------------
# 12. Port public, Kafka retry và SQL logging
# ----------------------------------------------------------------------------
PUBLIC_HTTP_PORT=8088
PUBLIC_HTTPS_PORT=8443
KAFKA_RETRY_BASE_DELAY_MS=250
KAFKA_RETRY_MAX_DELAY_MS=5000
KAFKA_PUBLISH_TIMEOUT_MS=10000
CATALOG_TYPEORM_LOGGING=false
ORDER_TYPEORM_LOGGING=false
SHIPPING_TYPEORM_LOGGING=false
# Cấu hình build local ổn định trên Docker Desktop với nhiều service Node.
# Tắt Bake để Compose build từng target theo giới hạn song song bên dưới.
COMPOSE_BAKE=false
COMPOSE_PARALLEL_LIMIT=1
