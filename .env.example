# ============================================================
# Application services Docker Compose environment
# ============================================================
# Copy this file to .env before running docker compose.
# Infrastructure-only variables remain in infra/docker/.env.
# Never commit the copied .env because it may contain secrets.
# ============================================================

POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=changeme_postgres
KEYCLOAK_CLIENT_SECRET=changeme_keycloak_secret
KEYCLOAK_WEB_CLIENT_SECRET=
INTERNAL_SERVICE_TOKEN=local-internal-token

# AI embedding worker. Keep the real key only in local .env or a secret manager.
AI_RUNTIME_MODE=memory
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QDRANT_COLLECTION_VERSION=1
QDRANT_ALIAS_PROMOTION_ENABLED=false
RECOMMENDATION_CACHE_TTL_SECONDS=300
RECOMMENDATION_SESSION_TTL_SECONDS=86400
RECOMMENDATION_SESSION_MAX_RECENT_ITEMS=30
