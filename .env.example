# ============================================================
# Application services Docker Compose environment
# ============================================================
# Copy this file to .env before running docker compose.
# Infrastructure-only variables remain in infra/docker/.env.
# Never commit the copied .env because it may contain secrets.
# ============================================================

POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=changeme_postgres
KEYCLOAK_CLIENT_SECRET=changeme_keycloak_secret
KEYCLOAK_WEB_CLIENT_SECRET=
INTERNAL_SERVICE_TOKEN=local-internal-token
