          <mxGeometry x="1120" y="620" width="350" height="360" as="geometry" />
        </mxCell>

        <mxCell id="image" value="&lt;b&gt;product_images&lt;/b&gt;&lt;hr&gt;id: uuid PK&lt;br&gt;product_id: uuid FK&lt;br&gt;variant_id: uuid FK nullable&lt;br&gt;image_url: text&lt;br&gt;alt_text: varchar nullable&lt;br&gt;sort_order: int&lt;br&gt;is_thumbnail: boolean&lt;br&gt;external_image_id: varchar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="300" height="220" as="geometry" />
