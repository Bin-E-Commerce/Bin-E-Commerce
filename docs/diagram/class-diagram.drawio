  <diagram id="product-import-class-diagram" name="Product Import Class Diagram">
    <mxGraphModel dx="1398" dy="696" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Product Crawl / Import Class Diagram&lt;/b&gt;&lt;br&gt;Based on packages/crawl-tiki/data/test-products.json and database import graph" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="860" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Rules from sample data&lt;/b&gt;&lt;br&gt;- One product graph contains categoryChain, brand, shop, product, images, variants, inventories, attributes, reviews.&lt;br&gt;- If source has no option/variant, importer creates one default variant and one inventory row.&lt;br&gt;- external_* + source_platform are used for idempotent upsert and source traceability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="40" width="560" height="120" as="geometry" />
        </mxCell>

        <mxCell id="svc-source" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;ProductSourceAdapter&lt;/b&gt;&lt;hr&gt;platform: SourcePlatform&lt;br&gt;listProducts(query)&lt;br&gt;getProductDetail(externalId)&lt;br&gt;getProductReviews(productId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="svc-tiki" value="&lt;b&gt;TikiSourceAdapter&lt;/b&gt;&lt;hr&gt;platform = tiki&lt;br&gt;normalizes raw Tiki API&lt;br&gt;builds source product detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="svc-crawler" value="&lt;b&gt;ProductCrawlerService&lt;/b&gt;&lt;hr&gt;crawl(options)&lt;br&gt;resolve category/product pages&lt;br&gt;detail + reviews + checkpoint&lt;br&gt;map + validate + optional import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="150" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="svc-mapper" value="&lt;b&gt;ProductMapper&lt;/b&gt;&lt;hr&gt;mapToImportGraph(source)&lt;br&gt;map categories/brand/shop&lt;br&gt;map options/variants/images&lt;br&gt;map attributes/reviews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="svc-repo" value="&lt;b&gt;PostgresProductImportRepository&lt;/b&gt;&lt;hr&gt;upsertProductGraph(graph)&lt;br&gt;transaction boundary&lt;br&gt;upsert categories, brand, shop&lt;br&gt;upsert product aggregate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="190" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dto-graph" value="&lt;b&gt;ImportProductGraph&lt;/b&gt;&lt;hr&gt;categoryChain: ImportCategory[]&lt;br&gt;brand: ImportBrand | null&lt;br&gt;shop: ImportShop | null&lt;br&gt;product: ImportProduct&lt;br&gt;images: ImportProductImage[]&lt;br&gt;options: ImportProductOption[]&lt;br&gt;variants: ImportProductVariant[]&lt;br&gt;inventories: ImportInventory[]&lt;br&gt;attributes: ImportAttribute[]&lt;br&gt;reviews: ImportReview[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="340" width="330" height="230" as="geometry" />
        </mxCell>

        <mxCell id="category" value="&lt;b&gt;categories&lt;/b&gt;&lt;hr&gt;id: uuid PK&lt;br&gt;parent_id: uuid FK nullable&lt;br&gt;name: varchar&lt;br&gt;slug: varchar UNIQUE&lt;br&gt;level: int&lt;br&gt;sort_order: int&lt;br&gt;is_active: boolean&lt;br&gt;source_platform: varchar&lt;br&gt;external_category_id: varchar&lt;br&gt;source_url: text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
