          <mxGeometry x="420" y="650" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="shop" value="&lt;b&gt;shops&lt;/b&gt;&lt;hr&gt;id: uuid PK&lt;br&gt;owner_id: uuid FK nullable&lt;br&gt;name: varchar&lt;br&gt;slug: varchar UNIQUE&lt;br&gt;avatar_url: text nullable&lt;br&gt;description: text nullable&lt;br&gt;status: enum&lt;br&gt;source_platform: varchar&lt;br&gt;external_shop_id: varchar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="650" width="280" height="230" as="geometry" />
